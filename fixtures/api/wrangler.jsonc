{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Demo client production target. CommonForge publishes this Worker from an
  // accepted release; /version is the post-publish health check.
  "name": "commonforge-demo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "vars": {
    "APP_VERSION": "1.0.0"
  }
}
