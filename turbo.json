{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:fault": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:security": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:live": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "CF_API_TOKEN",
        "CF_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "COMMONFORGE_NAMESPACE_PREFIX"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
